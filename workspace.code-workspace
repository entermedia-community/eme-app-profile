{
	"folders": [
		{
			"name": "eme_app_profile",
			"path": ".",
		},
		{
			"name": "eme_app_sdk",
			"path": "../eme-app-sdk",
		},
		{
			"name": "eme-server",
			"path": "../eme-server",
		},
	],
	"settings": {
		"remoteControl.enable": true,
		"remoteControl.port": 3709,
		"cSpell.words": ["entermedia"],
		"java.format.settings.url": "../eme-server/formatter.xml",
		"java.compile.nullAnalysis.mode": "automatic",
		"java.configuration.updateBuildConfiguration": "interactive",
		// Velocity-templated JSON in eme-server (extension: eme-server/tools/vscode-velocity-json)
		"files.associations": {
			"**/eme-server/plugins/*/html/**/*.json": "velocity-json",
		},
	},
	"extensions": {
		"recommendations": ["eliostruyf.vscode-remote-control"],
	},
}
